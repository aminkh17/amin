---
import { profile } from "../data/amin";
---

<nav class="profile-links" aria-label="Profiles and source code">
	{profile.links.map((link) => (
		<a
			class="profile-icon-link"
			href={link.href}
			aria-label={`${link.label} (opens in a new tab)`}
			title={link.label}
			target="_blank"
			rel="noopener noreferrer"
		>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
				{link.id === "repository" && <path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16" />}
				{link.id === "github" && <path fill="currentColor" stroke="none" d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.467-1.334-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.045.138 3.003.404 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />}
				{link.id === "linkedin" && (
					<g>
						<rect x="3" y="3" width="18" height="18" rx="2" />
						<circle cx="7.5" cy="7.5" r="1" fill="currentColor" stroke="none" />
						<path d="M7.5 11v6m3.5 0v-6m0 2.5c0-1.4 1-2.5 2.5-2.5s2.5 1.1 2.5 2.5V17" />
					</g>
				)}
				{link.id === "instagram" && (
					<g>
						<rect x="3" y="3" width="18" height="18" rx="5" />
						<circle cx="12" cy="12" r="4" />
						<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
					</g>
				)}
			</svg>
		</a>
	))}
</nav>
