{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "amin-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-25",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	// Source-only extraction: no custom domains, D1, R2, KV, Images or cron.
	// amin.kuara.dev still belongs to the existing kuara-dev deployment.
	// A hosting migration requires a separate explicit cutover.
}
