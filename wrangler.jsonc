{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "amin-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-25",
	"compatibility_flags": ["nodejs_compat"],
	// Production is served only from the custom domain. Rollback uses the
	// previous kuara-dev deployment or a Cloudflare version rollback.
	"workers_dev": false,
	"preview_urls": false,
	// Only the personal hostname moves here. kuara.dev stays on kuara-dev.
	"routes": [{ "pattern": "amin.kuara.dev", "custom_domain": true }],
	// No D1, R2, KV, Images or cron bindings are required.
}
