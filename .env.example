# Optional: use a different external professional résumé source.
# Otherwise the owner-local default is ~/Sources/resume-metadata/my-resume.yaml.
# Personal phone and personal email are never exported.
# RESUME_SOURCE=/absolute/path/to/my-resume.yaml

# Optional semantic alias/sector hints, separate from reusable code.
# Default: config/resume-hints.local.json (gitignored).
# RESUME_HINTS_SOURCE=/absolute/path/to/resume-hints.json
